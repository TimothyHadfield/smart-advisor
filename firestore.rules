rules_version = '2';

// Each signed-in student reads and writes only their own document:
//   users/{uid}   {taken, grades, settings, program, catalogYear, updatedAt}
// Everything else is denied.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
